generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model User {
  id        String @id @map("_id") @default(auto()) @db.ObjectId
  email     String @unique
  name      String
  password  String
  roles     String[]
  createdAt DateTime @default(now())
}

model Job {
  id          String   @id @map("_id") @default(auto()) @db.ObjectId
  title       String
  description String
  company     String
  location    String
  tags        String[]
  postedBy    String
  createdAt   DateTime @default(now())
}
